    "@xterm/xterm": "6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-reconciler": "0.33.0",
    "vanilla-framework": "4.52.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
